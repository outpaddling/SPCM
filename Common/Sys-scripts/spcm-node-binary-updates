##########################################################################

usage()
{
    printf "Usage: $0\n"
    exit 64     # sysexits(3) EX_USAGE
}


##########################################################################
#   Main
##########################################################################

if [ $# != 0 ]; then
    usage
fi

auto-root-check $0 'Installs OS updates.'

case $(auto-ostype) in
FreeBSD)
    pkg upgrade -y
    if ! auto-using-pkgbase; then
	freebsd-update fetch install
    fi
    ;;

*)
    printf "$0: Not supported on $remote_os.\n"
    exit 1
    ;;
    
esac
